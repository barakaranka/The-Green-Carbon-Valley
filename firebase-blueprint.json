{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile for Green Carbon Valley farmers, agronomists, and administrators",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["farmer", "agronomist", "partner", "admin"] },
        "region": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "BiocharBatch": {
      "title": "BiocharBatch",
      "description": "Logged biochar production batch with pyrolytic parameters and verified carbon sequestration metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "farmerName": { "type": "string" },
        "feedstock": { "type": "string" },
        "biomassKg": { "type": "number" },
        "biocharKg": { "type": "number" },
        "co2eKg": { "type": "number" },
        "retortMethod": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["userId", "feedstock", "biomassKg", "biocharKg", "co2eKg"]
    },
    "CarbonScenario": {
      "title": "CarbonScenario",
      "description": "Saved sequestration forecast scenario by smallholder farmers or agronomists",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "monthlyFeedstockKg": { "type": "number" },
        "annualBiocharKg": { "type": "number" },
        "annualCo2eKg": { "type": "number" },
        "feedstockType": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "monthlyFeedstockKg"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profiles with personal role and location"
    },
    "/batches/{batchId}": {
      "schema": { "$ref": "#/entities/BiocharBatch" },
      "description": "Collection of verified community and skid-retort biochar production runs"
    },
    "/scenarios/{scenarioId}": {
      "schema": { "$ref": "#/entities/CarbonScenario" },
      "description": "Saved calculation forecasts for farm-level carbon credit planning"
    }
  }
}
